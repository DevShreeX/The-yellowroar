table {
  margin: 30px auto;
  width: 95%;
  border-collapse: collapse;
  background: white;
  color: black;
  border-radius: 10px;
  overflow: hidden;
}

th {
  background: #FDB913;
  color: #1E3A8A;
  padding: 12px;
}

td {
  padding: 10px;
  border-bottom: 1px solid #ddd;
  text-align: center;
}

tr:nth-child(even) {
