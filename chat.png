<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chat with Leo</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #fff;
}

.container {
    display: flex;
    min-height: 100vh;
}

/* LEFT PANEL */
.left-panel {
    flex: 1;
    padding: 40px;
    background: linear-gradient(160deg, #1d4ed8, #3b82f6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* HERO SECTION */
.hero-image {
    text-align: center;
}

.mascot {
    width: 220px;
    margin-bottom: 20px;
    animation: float 3s ease-in-out infinite;
}

/* Floating */
@keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

/* TEXT */
.text-content {
    max-width: 450px;
    text-align: center;
}

.text-content h1 {
    margin-bottom: 15px;
}

.text-content p {
    margin-bottom: 10px;
    color: #e2e8f0;
}

.text-content span {
    color: #fde047;
    font-weight: bold;
}

.text-content h3 {
    margin-top: 15px;
    color: #facc15;
}

/* RIGHT PANEL */
.right-panel {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(160deg, #facc15, #fbbf24);
}

/* BUBBLES */
.bubble {
    position: absolute;
    padding: 10px 16px;
    border-radius: 20px;
    font-size: 14px;
    color: #fff;
    background: linear-gradient(135deg, #667eea, #764ba2);
    animation: float 4s infinite ease-in-out;
}

.b1 { top: 10%; left: 10%; }
.b2 { top: 25%; right: 10%; }
.b3 { bottom: 30%; left: 15%; }
.b4 { bottom: 10%; right: 15%; }
.b5 { top: 50%; left: 5%; }
.b6 { top: 60%; right: 5%; }
.b7 { bottom: 20%; left: 40%; }
.b8 { top: 15%; right: 35%; }

/* LOGIN */
.login-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(15px);
    background: rgba(255,255,255,0.15);
    padding: 30px;
    border-radius: 20px;
    text-align: center;
}

.login-box h3 {
    color: #1e293b;
}

.login-box p {
    color: #1e293b;
    margin: 10px 0;
}

.login-box button {
    padding: 10px 20px;
    border: none;
    border-radius: 20px;
    background: #1e293b;
    color: #fff;
    cursor: pointer;
}

/* TITLE */
.hotline-title {
    position: absolute;
    top: 30px;
    color: #1e293b;
}
</style>
</head>

<body>

<main class="container">

    <!-- LEFT PANEL -->
    <section class="left-panel">

        <div class="hero-image">
            <!-- FIXED IMAGE -->
            <img src="leo macsot.html"width="700">
        </div>

        <!-- TEXT PROPERLY ALIGNED -->
        <div class="text-content">
            <h1>Hey makkaley! 💛</h1>

            <p>Hello <span>Yellove Army</span>! Your lion is here from the den 🦁</p>

            <p>The roar you bring to the stadium... we feel it every match!</p>

            <p>Got questions about matches, players, or moments?</p>

            <p><strong>Drop your questions and let’s talk cricket! 🏏 and have some fun with us </strong></p>

            <h3>#WhistlePodu</h3>
        </div>

    </section>

    <!-- RIGHT PANEL -->
    <section class="right-panel">

        <!-- BUBBLES -->
        <div class="bubble b1">Thala Aadraara?</div>
        <div class="bubble b2">Auction?</div>
        <div class="bubble b3">Chettan Vannaley?!</div>
        <div class="bubble b4">Naan vilven endru nenaithaiyooo</div>
        <div class="bubble b5">Cup Mukiyam Leo!</div>
        <div class="bubble b6">Ippadai thorkin eppadai vellum?</div>
        <div class="bubble b7">Dei pacha satta!</div>
        <div class="bubble b8">Suthi nindru oorey!</div>

        <!-- LOGIN CENTER -->
        <div class="login-box">
            <h3>Login Required</h3>
            <p>Login pannunga… pesalaam 😉</p>
            <a href="leo login.html">
                <button>CLICK HERE</button>
            </a>
        </div>

        <h2 class="hotline-title">chat with leo 🐦‍🔥</h2>

    </section>

</main>
<div class="footer">
  © 2026 Chennai Super Kings Fan Page
</div>

</body>
</html>